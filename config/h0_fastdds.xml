<?xml version="1.0" encoding="UTF-8"?>
<!-- Local H0 image transport. A 640x480 RGB message exceeds default 512 KiB SHM.
     Applies only through h0_ros_env.sh; no global DDS/system configuration. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>h0_shm</transport_id>
      <type>SHM</type>
      <maxMessageSize>4194304</maxMessageSize>
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>h0_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="h0_local_rgbd" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>h0_shm</transport_id>
        <transport_id>h0_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
